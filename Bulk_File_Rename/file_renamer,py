import os
import sys

def get_directory(prompt: str) -> str:
    while True:
        path = input(prompt).strip()
        if path.lower() == "exit":
            print("Goodbye!")
            sys.exit()
        if os.path.isdir(path):
            return path
        print("Directory does not exist. Please enter a valid path.")

def list_files(directory: str, extension: str = "") -> list[str]:
    files = []
    for item in os.listdir(directory):
        full_path = os.path.join(directory, item)
        if os.path.isfile(full_path):
            if not extension or item.lower().endswith(extension.lower()):
                files.append(item)
    return sorted(files)

def preview_renames(directory: str, renames: list[tuple[str, str]]):
    print("\n--- Preview Changes ---")
    for old_name, new_name in renames:
        print(f"{old_name} -> {new_name}")
    print("-" * 30)

def apply_renames(directory: str, renames: list[tuple[str, str]]):
    for old_name, new_name in renames:
        old_path = os.path.join(directory, old_name)
        new_path = os.path.join(directory, new_name)
        try:
            os.rename(old_path, new_path)
        except OSError as e:
            print(f"Failed to rename '{old_name}': {e}")
    print(f"\nSuccessfully renamed {len(renames)} file(s).")

def rename_sequential(directory: str, files: list[str]):
    prefix = input("Enter new base name (e.g., photo): ").strip()
    start_num = input("Enter starting number (default 1): ").strip()
    start_num = int(start_num) if start_num.isdigit() else 1

    renames = []
    for idx, filename in enumerate(files, start=start_num):
        ext = os.path.splitext(filename)[1]
        new_name = f"{prefix}_{idx:03d}{ext}"
        renames.append((filename, new_name))

    preview_renames(directory, renames)
    confirm = input("Apply these changes? (y/n): ").strip().lower()
    if confirm in ["y", "yes"]:
        apply_renames(directory, renames)

def rename_replace(directory: str, files: list[str]):
    find_str = input("Enter text to replace: ")
    replace_str = input("Enter replacement text: ")

    renames = []
    for filename in files:
        if find_str in filename:
            new_name = filename.replace(find_str, replace_str)
            renames.append((filename, new_name))

    if not renames:
        print("No files matched the search text.")
        return

    preview_renames(directory, renames)
    confirm = input("Apply these changes? (y/n): ").strip().lower()
    if confirm in ["y", "yes"]:
        apply_renames(directory, renames)

def rename_add_prefix_suffix(directory: str, files: list[str]):
    prefix = input("Enter prefix to add (leave empty for none): ")
    suffix = input("Enter suffix to add (leave empty for none): ")

    renames = []
    for filename in files:
        name, ext = os.path.splitext(filename)
        new_name = f"{prefix}{name}{suffix}{ext}"
        renames.append((filename, new_name))

    preview_renames(directory, renames)
    confirm = input("Apply these changes? (y/n): ").strip().lower()
    if confirm in ["y", "yes"]:
        apply_renames(directory, renames)

def rename_change_case(directory: str, files: list[str]):
    print("1. Lowercase")
    print("2. Uppercase")
    print("3. Title Case")
    choice = input("Select case format (1-3): ").strip()

    renames = []
    for filename in files:
        name, ext = os.path.splitext(filename)
        if choice == "1":
            new_name = f"{name.lower()}{ext.lower()}"
        elif choice == "2":
            new_name = f"{name.upper()}{ext.lower()}"
        elif choice == "3":
            new_name = f"{name.title()}{ext.lower()}"
        else:
            print("Invalid selection.")
            return
        renames.append((filename, new_name))

    preview_renames(directory, renames)
    confirm = input("Apply these changes? (y/n): ").strip().lower()
    if confirm in ["y", "yes"]:
        apply_renames(directory, renames)

def main():
    print("=== Bulk File Renamer ===")
    print("Type 'exit' at any prompt to quit.\n")

    while True:
        target_dir = get_directory("\nEnter directory path: ")
        filter_ext = input("Filter by extension (e.g., .jpg, .png or leave empty for all): ").strip()

        files = list_files(target_dir, filter_ext)
        if not files:
            print("No matching files found in the directory.")
            continue

        print(f"\nFound {len(files)} file(s).")
        print("\nRenaming Options:")
        print("1. Sequential Numbering (e.g., photo_001.jpg)")
        print("2. Find and Replace Text")
        print("3. Add Prefix / Suffix")
        print("4. Change Case (Upper/Lower/Title)")
        print("5. Choose Another Directory")
        print("6. Exit")

        choice = input("\nSelect operation (1-6): ").strip().lower()

        if choice in ["6", "exit"]:
            print("Goodbye!")
            sys.exit()
        elif choice == "1":
            rename_sequential(target_dir, files)
        elif choice == "2":
            rename_replace(target_dir, files)
        elif choice == "3":
            rename_add_prefix_suffix(target_dir, files)
        elif choice == "4":
            rename_change_case(target_dir, files)
        elif choice == "5":
            continue
        else:
            print("Invalid choice. Select a valid option.")

if __name__ == "__main__":
    main()